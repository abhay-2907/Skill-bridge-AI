# App Settings
APP_NAME="SkillBridge AI"
ENVIRONMENT=development
DEBUG=True

# Database
DATABASE_URL=sqlite+aiosqlite:///./careerpilot.db

# Security
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Open-Source Models (Groq - FREE Llama 3.3 / Mixtral API)
# Get a free key instantly from: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# IBM watsonx.ai / Granite Credentials
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# RAG & Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_PATH=rag/vector_store/faiss_index
